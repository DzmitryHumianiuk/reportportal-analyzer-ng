+            <span aria-hidden>+</span> {formatMessage(messages.benchCmtAddReason)}
+          </button>
+        )}
+
+        {/* commit row: exact-group scope + recap left, Cancel + Apply right */}
+        <div className={cx('commit-row')}>
+          <div className={cx('commit-left')}>
