+
+/*
+ * The Bench — RP Design System 6 (light) re-skin of the Make Decision modal.
+ * Tokens + values are quoted from docs/consilium-make-decision/mockup-bench-rp.html.
+ * Everything is scoped under .bench-modal so the light surface never leaks into the
+ * surrounding dark modal chrome.
+ */
+
+// Full-width shell (ng3): the Bench fills the modal width up to a graceful 1600px cap,
+// reclaiming the empty dark margins the ~1180px-capped ng2 Bench left. The dark modal
+// shell spans the whole screen; this centres the light surface and caps it.
+.modal-scroll {
+  max-width: 1600px;
+  margin: 0 auto;
+  overflow-x: auto;
+}
+
+.bench-modal {
+  // RP Design System 6 tokens (mockup :root)
+  --rp-bg-000: #ffffff;
+  --rp-bg-100: #f7f7f8;
+  --rp-bg-200: #eceff4;
+  --rp-topaz-100: #e5f5f8;
+  --rp-topaz: #00829b;
+  --rp-topaz-hover: #009dbb;
+  --rp-topaz-focused: #00b0d1;
+  --rp-topaz-pressed: #00758c;
+  --rp-almost-black: #3f3f3f;
+  --rp-charcoal: #464547;
+  --rp-e-100: #e3e7ec;
+  --rp-e-200: #c1c7d0;
+  --rp-e-300: #a2aab5;
+  --rp-e-400: #8d95a1;
+  --rp-error: #dc5959;
+  --rp-a-red-700: #c33c3d;
+  --rp-yellow-800: #ffc208;
+  --rp-yellow-700: #d4a002;
+  --rp-sm-warning: #d78706;
+  --rp-sm-warning-line-100: #fceecb;
+  --rp-sm-warning-line-200: #fbe7b6;
+  --rp-status-passed: #3aa76d;
+  --rp-a-green-800: #1c8b50;
+  --rp-shadow-rgb: 55, 67, 98;
+  --rp-shadow: 0 1px 3px rgba(var(--rp-shadow-rgb), 0.1);
+  --rp-shadow-hover: 0 1px 3px rgba(var(--rp-shadow-rgb), 0.2);
+  --rp-shadow-secondary: 0 8px 40px rgba(0, 0, 0, 0.15);
+  --rp-font: Roboto, Arial, Helvetica, sans-serif;
+  --rp-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
+  --muted3: #8d95a1;
+
+  width: 100%;
+  min-width: 1080px;
+  margin: 0 0 10px 0;
+  background: var(--rp-bg-000);
+  border-radius: 16px;
+  overflow: hidden;
+  box-shadow: var(--rp-shadow-secondary);
+  border: 1px solid var(--rp-e-100);
+  font-family: var(--rp-font);
+  color: var(--rp-almost-black);
+  font-size: 13px;
+  line-height: 20px;
+
+  a {
+    color: var(--rp-topaz);
+  }
+
+  // ---- shared bits -------------------------------------------------------
+  .insp-link {
+    display: inline-flex;
+    align-items: center;
+    gap: 3px;
+    color: var(--rp-topaz);
+    text-decoration: none;
+    font-size: 12px;
+    white-space: nowrap;
+
+    &:hover {
+      text-decoration: underline;
+    }
+  }
+
+  .tip {
+    border-bottom: 1px dotted var(--rp-e-300);
+    cursor: help;
+  }
+
+  .dot {
+    display: inline-block;
+    width: 9px;
+    height: 9px;
+    border-radius: 50%;
+    flex: none;
+  }
+
+  .kbd {
+    display: inline-block;
+    font-family: var(--rp-mono);
+    font-size: 11px;
+    line-height: 16px;
+    padding: 0 5px;
+    background: var(--rp-bg-200);
+    border: 1px solid var(--rp-e-200);
+    border-radius: 3px;
+    color: var(--rp-charcoal);
+  }
+
+  // ---- buttons (§5.1) ----------------------------------------------------
+  .btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    border-radius: 3px;
+    font-size: 13px;
+    line-height: 20px;
+    font-weight: 500;
+    font-family: var(--rp-font);
+    padding: 7px 14px;
+    border: 1px solid transparent;
+    cursor: pointer;
+    background: transparent;
+    transition: background 0.12s, border-color 0.12s, color 0.12s;
+  }
+  .btn-sm {
+    padding: 5px 11px;
+    font-size: 12px;
+  }
+  .btn-teal {
+    background: var(--rp-topaz);
+    color: #fff;
+    border-color: var(--rp-topaz);
+
+    &:hover {
+      background: var(--rp-topaz-hover);
+      border-color: var(--rp-topaz-hover);
+    }
+    &:active {
+      background: var(--rp-topaz-pressed);
+    }
+    &:disabled {
+      opacity: 0.5;
+      cursor: default;
+    }
+  }
+  .btn-ghost {
+    background: transparent;
+    border-color: var(--rp-topaz);
+    color: var(--rp-topaz);
+
+    &:hover {
+      background: var(--rp-topaz-100);
+    }
+  }
+
+  // ---- bands -------------------------------------------------------------
+  .band {
+    padding: 16px 24px;
+    border-bottom: 1px solid var(--rp-e-100);
+  }
+  .band-white {
+    background: var(--rp-bg-000);
+  }
+  .band-grey {
+    background: var(--rp-bg-100);
+  }
+
+  // ---- stripe (item header) ---------------------------------------------
+  .stripe {
+    display: flex;
+    align-items: flex-start;
+    justify-content: space-between;
+    gap: 16px;
+    padding: 15px 24px 14px;
+
+    .stripe-left .name {
+      font-size: 15px;
+      font-weight: 600;
+      color: var(--rp-almost-black);
+    }
+    .stripe-left .meta {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+      margin-top: 3px;
+      font-size: 12px;
+      color: var(--rp-e-400);
+    }
+    .status-pill {
+      display: inline-flex;
+      align-items: center;
+      gap: 5px;
+      color: var(--rp-charcoal);
+    }
+    .stripe-right {
+      display: flex;
+      align-items: center;
+      gap: 16px;
+      flex: none;
+    }
+    .logtoggle {
+      display: inline-flex;
+      align-items: center;
+      gap: 5px;
+      cursor: pointer;
+      color: var(--rp-topaz);
+      font-size: 13px;
+      user-select: none;
+
+      .chev {
+        display: inline-block;
+        transition: transform 0.15s;
+        font-size: 10px;
+      }
+      &.open .chev {
+        transform: rotate(90deg);
+      }
+    }
+  }
+
+  // ---- R1 "This failure" -------------------------------------------------
+  .failure-panel {
+    padding: 12px 24px;
+
+    .fp-line {
+      display: flex;
+      gap: 12px;
+    }
+    .fp-bar {
+      width: 4px;
+      border-radius: 2px;
+      background: var(--rp-error);
+      flex: none;
+    }
+    .fp-cap {
+      font-size: 10px;
+      font-weight: 700;
+      letter-spacing: 0.4px;
+      text-transform: uppercase;
+      color: var(--rp-e-400);
+      margin-bottom: 3px;
+    }
+    .fp-top {
+      font-family: var(--rp-mono);
+      font-size: 12.5px;
+      color: var(--rp-almost-black);
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+    .fp-sub {
+      font-family: var(--rp-mono);
+      font-size: 11.5px;
+      color: var(--rp-e-400);
+      margin-top: 2px;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+    .fulllog {
+      margin: 12px 0 0 16px;
+      background: var(--rp-bg-000);
+      border: 1px solid var(--rp-e-100);
+      border-radius: 8px;
+      padding: 10px 12px;
+      max-height: 230px;
+      overflow: auto;
+      box-shadow: var(--rp-shadow);
+
+      .lg-cap {
+        font-size: 10px;
+        font-weight: 700;
+        letter-spacing: 0.4px;
+        text-transform: uppercase;
+        color: var(--rp-e-400);
+        margin-bottom: 6px;
+      }
+      .logrow {
+        font-family: var(--rp-mono);
+        font-size: 12px;
+        line-height: 18px;
+        color: var(--rp-charcoal);
+        white-space: pre-wrap;
+        word-break: break-word;
+      }
+      .logrow.star {
+        color: var(--rp-yellow-700);
+        font-weight: 700;
+      }
+    }
+  }
+
+  // ---- full-width body: left context column + main bench (ng3) -----------
+  .bench-split {
+    display: flex;
+    align-items: stretch;
+    border-bottom: 1px solid var(--rp-e-100);
+  }
+  .context-col {
+    width: 340px;
+    flex: none;
+    background: var(--rp-bg-100);
+    border-right: 1px solid var(--rp-e-100);
+    padding: 16px 20px;
+  }
+  .bench-main {
+    flex: 1;
+    min-width: 0;
+  }
+  .lp-cap {
+    font-size: 11px;
+    line-height: 16px;
+    font-weight: 700;
+    letter-spacing: 0.8px;
+    text-transform: uppercase;
+    color: var(--rp-e-400);
+    margin: 0 0 10px;
+  }
+
+  // ---- group of identical failures (first-class context, left column) ----
+  .group-block {
+    background: var(--rp-bg-000);
+    border: 1px solid var(--rp-e-100);
+    border-radius: 8px;
+    padding: 12px 13px;
+    box-shadow: var(--rp-shadow);
+
+    .group-actions {
+      margin-top: 10px;
+    }
+    .group-pointer {
+      margin-top: 10px;
+    }
+  }
+  .group-alone {
+    background: var(--rp-bg-000);
+    border: 1px dashed var(--rp-e-200);
+    border-radius: 8px;
+    padding: 12px 13px;
+    color: var(--rp-e-400);
+    font-size: 12.5px;
+    line-height: 1.5;
+    display: flex;
+    align-items: flex-start;
+    gap: 9px;
+
+    .ga-glyph {
+      flex: none;
+      width: 26px;
+      height: 26px;
+      border-radius: 100px;
+      background: var(--rp-bg-200);
+      color: var(--rp-e-400);
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      font-size: 11px;
+    }
+    b {
+      color: var(--rp-charcoal);
+      font-weight: 600;
+    }
+  }
+  .group-line {
+    display: flex;
+    align-items: flex-start;
+    gap: 12px;
+  }
+  .group-badge {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-width: 30px;
+    height: 26px;
+    padding: 0 8px;
+    background: var(--rp-topaz-100);
+    color: var(--rp-topaz);
+    border: 1px solid #bfe6ee;
+    border-radius: 13px;
+    font-size: 15px;
+    font-weight: 700;
+    flex: none;
+  }
+  .group-main {
+    flex: 1;
+    min-width: 0;
+  }
+  .group-head {
+    font-size: 13px;
+    line-height: 1.45;
+    color: var(--rp-almost-black);
+
+    b {
+      font-weight: 700;
+    }
+  }
+  .group-sub {
+    margin-top: 3px;
+    font-size: 12px;
+    color: var(--rp-e-400);
+    line-height: 1.45;
+  }
+  .group-pointer {
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    background: none;
+    border: none;
+    padding: 0;
+    cursor: pointer;
+    color: var(--rp-topaz);
+    font-size: 12px;
+
+    &:hover {
+      text-decoration: underline;
+    }
+  }
+  .group-members {
+    margin-top: 12px;
+    padding-top: 12px;
+    border-top: 1px solid var(--rp-e-100);
+
+    .gm-list {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 6px;
+    }
+    .gm-chip {
+      display: inline-flex;
+      align-items: center;
+      gap: 5px;
+      padding: 3px 9px;
+      background: var(--rp-bg-100);
+      border: 1px solid var(--rp-e-100);
+      border-radius: 100px;
+      font-size: 12px;
+      color: var(--rp-charcoal);
+
+      .gm-cur {
+        color: var(--rp-e-400);
+        font-style: italic;
+      }
+    }
+    .gm-foot {
+      display: flex;
+      align-items: center;
+      gap: 14px;
+      margin-top: 8px;
+      font-size: 12px;
+      color: var(--rp-e-400);
+    }
+  }
+
+  // ---- agreement banner + bench -----------------------------------------
+  .bench-region {
+    padding: 16px 24px;
+    background: var(--rp-bg-000);
+    border-bottom: 1px solid var(--rp-e-100);
+  }
+  .region-head {
+    display: flex;
+    align-items: baseline;
+    justify-content: space-between;
+    gap: 12px;
+    flex-wrap: wrap;
+    padding: 11px 14px;
+    border-radius: 8px;
+    border: 1px solid var(--rp-e-100);
+    background: var(--rp-bg-100);
+    margin-bottom: 12px;
+
+    &.unsure {
+      background: var(--rp-sm-warning-line-100);
+      border-color: var(--rp-sm-warning-line-200);
+
+      .headline-help {
+        color: #8a6a12;
+      }
+    }
+    &.agree {
+      background: var(--rp-topaz-100);
+      border-color: #bfe6ee;
+    }
+    .headline {
+      font-size: 15px;
+      font-weight: 700;
+      color: var(--rp-almost-black);
+
+      .verd {
+        color: var(--rp-topaz-pressed);
+      }
+    }
+    .headline-help {
+      font-size: 12.5px;
+      color: var(--rp-e-400);
+    }
+  }
+  .region-cap {
+    font-size: 11px;
+    font-weight: 700;
+    letter-spacing: 0.4px;
+    text-transform: uppercase;
+    color: var(--rp-e-400);
+    margin-bottom: 10px;
+  }
+  .bench-row {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: stretch;
+    gap: 14px;
+  }
+
+  // ---- advisor check cards (flexible: spread across the widened bench) ----
+  .check {
+    flex: 1 1 240px;
+    max-width: 380px;
+    background: var(--rp-bg-000);
+    border: 1px solid var(--rp-e-200);
+    border-radius: 8px;
+    padding: 12px 13px 12px 15px;
+    position: relative;
+    box-shadow: var(--rp-shadow);
+    transition: border-color 0.15s, box-shadow 0.15s;
+
+    .edge {
+      position: absolute;
+      left: 0;
+      top: 0;
+      bottom: 0;
+      width: 4px;
+      border-radius: 8px 0 0 8px;
+    }
+    &.auto .edge {
+      background: var(--rp-status-passed);
+    }
+    &.suggest .edge {
+      background: linear-gradient(var(--rp-yellow-700) 50%, var(--rp-e-200) 50%);
+    }
+    &.abstain .edge {
+      background: var(--rp-e-300);
+    }
+    &.rubric {
+      border-style: dashed;
+      border-color: var(--rp-e-300);
+
+      .edge {
+        background: repeating-linear-gradient(
+          180deg,
+          var(--rp-e-300) 0 4px,
+          transparent 4px 8px
+        );
+      }
+    }
+    &.empty {
+      opacity: 0.75;
+      border-style: dashed;
+      box-shadow: none;
+      background: var(--rp-bg-100);
+    }
+
+    .why {
+      position: absolute;
+      top: 10px;
+      right: 11px;
+    }
+    .method {
+      display: flex;
+      align-items: center;
+      gap: 6px;
+      font-size: 13.5px;
+      font-weight: 700;
+      color: var(--rp-almost-black);
+
+      .gl {
+        color: var(--rp-e-400);
+      }
+    }
+    .tag-nc {
+      display: inline-block;
+      margin-left: 6px;
+      padding: 0 6px;
+      border: 1px solid var(--rp-e-200);
+      border-radius: 3px;
+      font-size: 10px;
+      font-weight: 600;
+      color: var(--rp-e-400);
+      vertical-align: middle;
+    }
+    .role {
+      margin-top: 3px;
+      font-size: 12px;
+      color: var(--rp-e-400);
+    }
+    .verd-pill {
+      margin-top: 9px;
+    }
+    .strength {
+      margin-top: 9px;
+      font-size: 12.5px;
+      color: var(--rp-almost-black);
+
+      b {
+        font-weight: 700;
+      }
+    }
+    .prov {
+      margin-top: 5px;
+      font-size: 12px;
+      color: var(--rp-e-400);
+    }
+    .compare-btn {
+      margin-top: 10px;
+    }
+  }
+
+  // ---- defect pill (§5.3) ------------------------------------------------
+  .defect-pill {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    background: var(--rp-bg-000);
+    color: var(--rp-almost-black);
+    border: 1px solid var(--rp-e-200);
+    border-radius: 100px;
+    padding: 2px 9px 2px 7px;
+    font-size: 13px;
+    font-weight: 600;
+
+    .dot {
+      width: 12px;
+      height: 12px;
+    }
+  }
+
+  // ---- the line + declined dock (full-width horizontal strip, ng3) -------
+  .bar-sep {
+    flex-basis: 100%;
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    margin: 14px 0 10px;
+
+    .bar-rule {
+      flex: 1;
+      height: 0;
+      border-top: 2px dotted var(--rp-e-300);
+    }
+    .bar-lbl {
+      font-size: 10px;
+      color: var(--rp-e-400);
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      white-space: nowrap;
+      cursor: help;
+    }
+  }
+  .dock {
+    flex-basis: 100%;
+    align-self: flex-start;
+    border: 1px dashed var(--rp-e-300);
+    border-radius: 8px;
+    padding: 11px 13px;
+    background: var(--rp-bg-200);
+
+    .dock-toggle {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+      cursor: pointer;
+      width: 100%;
+      text-align: left;
+      font-size: 12.5px;
+      font-weight: 600;
+      color: var(--rp-e-400);
+      user-select: none;
+
+      .chev {
+        font-size: 11px;
+        transition: transform 0.15s;
+      }
+      &:not(.open) .chev {
+        transform: rotate(-90deg);
+      }
+    }
+    .dock-body {
+      display: grid;
+      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
+      gap: 8px;
+      margin-top: 10px;
+    }
+    .dock-note {
+      grid-column: 1 / -1;
+      margin-bottom: 2px;
+      font-size: 11.5px;
+      color: var(--rp-e-400);
+      line-height: 1.45;
+    }
+    .dock-item {
+      border: 1px dashed var(--rp-e-200);
+      border-radius: 6px;
+      padding: 9px 11px;
+      background: var(--rp-bg-000);
+      cursor: pointer;
+      transition: border-color 0.15s;
+
+      &:hover {
+        border-color: var(--rp-e-300);
+      }
+      &.focus {
+        border-color: var(--rp-e-400);
+        background: #fff;
+      }
+      .dn {
+        font-size: 12.5px;
+        color: var(--rp-charcoal);
+        font-weight: 600;
+      }
+      .dd {
+        margin-top: 4px;
+        font-size: 12px;
+        color: var(--rp-e-400);
+
+        .strike {
+          text-decoration: line-through;
+          text-decoration-color: var(--rp-e-300);
+          color: var(--rp-e-400);
+        }
+      }
+      .dact {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 10px;
+        margin-top: 9px;
+
+        .dock-adopt {
+          background: none;
+          border: none;
+          padding: 0;
+          cursor: pointer;
+          color: var(--rp-topaz);
+          font-size: 12px;
+
+          &:hover {
+            text-decoration: underline;
+          }
+        }
+      }
+    }
+  }
+
+  // ---- evidence stage ----------------------------------------------------
+  .stage {
+    padding: 18px 24px;
+    background: var(--rp-bg-000);
+
+    .ns-big {
+      font-size: 15px;
+      font-weight: 700;
+      color: var(--rp-almost-black);
+    }
+    .ns-sub {
+      margin-top: 4px;
+      font-size: 12.5px;
+      color: var(--rp-e-400);
+      max-width: 760px;
+    }
+    .verdict-line {
+      font-size: 14px;
+      color: var(--rp-almost-black);
+      margin-bottom: 12px;
+
+      b {
+        font-weight: 700;
+      }
+    }
+    .vcol {
+      background: var(--rp-bg-000);
+      border: 1px solid var(--rp-e-100);
+      border-radius: 8px;
+      padding: 11px 13px;
+      box-shadow: var(--rp-shadow);
+      margin-bottom: 12px;
+
+      h4 {
+        margin: 0 0 6px;
+        font-size: 10px;
+        font-weight: 700;
+        letter-spacing: 0.4px;
+        text-transform: uppercase;
+        color: var(--rp-e-400);
+      }
+      .difflog {
+        font-family: var(--rp-mono);
+        font-size: 12px;
+        line-height: 18px;
+        color: var(--rp-charcoal);
+        white-space: pre-wrap;
+        word-break: break-word;
+
+        .hot {
+          color: #7a5b00;
+          background: rgba(255, 194, 8, 0.18);
+          border-radius: 2px;
+          padding: 0 2px;
+        }
+      }
+      .prov-line {
+        margin-top: 8px;
+        font-size: 12px;
+        color: var(--rp-e-400);
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+    }
+  }
+
+  // ---- AI explanation strips --------------------------------------------
+  .ai-strip {
+    background: #fff;
+    border: 1px solid var(--rp-e-100);
+    border-left: 3px solid var(--rp-topaz);
+    border-radius: 0 8px 8px 0;
+    padding: 11px 14px;
+    box-shadow: var(--rp-shadow);
+
+    &.guess {
+      border-left-color: var(--rp-yellow-700);
+      background: var(--rp-sm-warning-line-100);
+      border-color: var(--rp-sm-warning-line-200);
+      border-left-width: 3px;
+
+      .ai-cap {
+        color: var(--rp-sm-warning);
+      }
+    }
+    .ai-cap {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+      font-size: 11px;
+      font-weight: 700;
+      letter-spacing: 0.3px;
+      text-transform: uppercase;
+      color: var(--rp-topaz-pressed);
+      margin-bottom: 6px;
+    }
+    .ai-text {
+      font-size: 12.5px;
+      line-height: 19px;
+      color: var(--rp-charcoal);
+      white-space: pre-wrap;
+      word-break: break-word;
+    }
+    .review-note {
+      margin-top: 8px;
+      font-size: 12px;
+      font-style: italic;
+      color: var(--rp-sm-warning);
+    }
+  }
+
+  // ---- log compare (R2) --------------------------------------------------
+  .compare {
+    .cmp-head {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+      margin-bottom: 6px;
+
+      .cmp-title {
+        font-size: 14px;
+        font-weight: 700;
+        color: var(--rp-almost-black);
+      }
+    }
+    .cmp-help {
+      font-size: 12px;
+      color: var(--rp-e-400);
+      margin-bottom: 10px;
+      display: flex;
+      align-items: center;
+      flex-wrap: wrap;
+      gap: 14px;
+
+      .cmp-legend {
+        display: flex;
+        gap: 12px;
+      }
+      .lg {
+        display: inline-flex;
+        align-items: center;
+        gap: 5px;
+      }
+      .sw {
+        width: 22px;
+        height: 12px;
+        border-radius: 3px;
+        display: inline-block;
+      }
+      .lg-same {
+        background: rgba(58, 167, 109, 0.14);
+        border: 1px solid rgba(58, 167, 109, 0.5);
+      }
+      .lg-diff {
+        background: rgba(255, 194, 8, 0.18);
+        border: 1px solid var(--rp-yellow-700);
+      }
+    }
+    .cmp-cols {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 16px;
+
+      @media (max-width: 980px) {
+        grid-template-columns: 1fr;
+      }
+    }
+    .cmp-col {
+      background: var(--rp-bg-000);
+      border: 1px solid var(--rp-e-100);
+      border-radius: 8px;
+      padding: 10px 12px;
+      box-shadow: var(--rp-shadow);
+      max-height: 260px;
+      overflow: auto;
+
+      .cmp-col-head {
+        font-size: 12px;
+        font-weight: 700;
+        color: var(--rp-almost-black);
+        margin-bottom: 2px;
+
+        .s {
+          display: block;
+          font-weight: 400;
+          font-size: 11px;
+          color: var(--rp-e-400);
+          margin-top: 2px;
+        }
+      }
+      .cmp-body {
+        margin-top: 8px;
+      }
+    }
+    .cmp-line {
+      font-family: var(--rp-mono);
+      font-size: 12px;
+      line-height: 18px;
+      padding: 1px 4px;
+      border-radius: 2px;
+      white-space: pre-wrap;
+      word-break: break-word;
+      position: relative;
+
+      &.same {
+        color: #2f6f4c;
+        background: rgba(58, 167, 109, 0.12);
+      }
+      &.diff {
+        color: #7a5b00;
+        background: rgba(255, 194, 8, 0.16);
+      }
+      .starwrap {
+        color: var(--rp-yellow-700);
+        font-weight: 700;
+        margin-right: 4px;
+      }
+      .sidetag {
+        margin-left: 8px;
+        font-family: var(--rp-font);
+        font-size: 10px;
+        color: var(--rp-yellow-700);
+        opacity: 0.85;
+      }
+    }
+    .cmp-nolog {
+      font-size: 12px;
+      color: var(--rp-e-400);
+      font-style: italic;
+    }
+    .cmp-verdict {
+      margin-top: 12px;
+
+      .cv-line {
+        font-size: 12.5px;
+        line-height: 19px;
+        color: var(--rp-charcoal);
+        background: var(--rp-bg-000);
+        border: 1px solid var(--rp-e-100);
+        border-radius: 8px;
+        padding: 10px 12px;
+      }
+    }
+    .cmp-foot {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+      margin-top: 12px;
+
+      .cmp-foot-left {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+        font-size: 12.5px;
+        color: var(--rp-e-400);
+      }
+    }
+  }
+
+  // ---- verdict bar (R3) --------------------------------------------------
+  .verdict-bar {
+    padding: 15px 24px;
+
+    .vb-top {
+      display: flex;
+      align-items: flex-start;
+      justify-content: space-between;
+      gap: 20px;
+      flex-wrap: wrap;
+    }
+    .vb-left {
+      display: flex;
+      flex-direction: column;
+      gap: 12px;
+      flex: 1;
+      min-width: 420px;
+    }
+    .vb-verdict-row {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      flex-wrap: wrap;
+    }
+    .flabel {
+      font-size: 12px;
+      font-weight: 600;
+      color: var(--rp-charcoal);
+    }
+    .prov-tag {
+      font-size: 12px;
+      color: var(--rp-e-400);
+      font-style: italic;
+
+      &.picked {
+        color: var(--rp-topaz-pressed);
+        font-style: normal;
+      }
+    }
+    .vb-actions {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-end;
+      gap: 8px;
+    }
+    .vb-btns {
+      display: flex;
+      gap: 8px;
+    }
+    .vb-keys {
+      font-size: 11px;
+      color: var(--rp-e-400);
+      display: flex;
+      align-items: center;
+      gap: 5px;
+      flex-wrap: wrap;
+    }
+    .manual-pane,
+    .comment-pane {
+      background: var(--rp-bg-100);
+      border: 1px solid var(--rp-e-100);
+      border-radius: 8px;
+      padding: 12px 13px;
+    }
+    .manual-head,
+    .cmt-head {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      font-size: 12px;
+      font-weight: 600;
+      color: var(--rp-charcoal);
+      margin-bottom: 8px;
+    }
+    .manual-help {
+      margin-top: 8px;
+      font-size: 12px;
+      color: var(--rp-e-400);
+    }
+    .cmt-check {
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      cursor: pointer;
+      font-weight: 400;
+      color: var(--rp-charcoal);
+      margin-left: auto;
+
+      .box {
+        width: 16px;
+        height: 16px;
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        border: 1px solid var(--rp-topaz);
+        border-radius: 3px;
+        background: var(--rp-topaz);
+        color: #fff;
+        font-size: 11px;
+      }
+      &.off .box {
+        background: var(--rp-bg-000);
+        border-color: var(--rp-e-200);
+        color: transparent;
+      }
+    }
+    .cmt-prefill-note {
+      font-size: 11.5px;
+      color: var(--rp-sm-warning);
+      margin-bottom: 6px;
+    }
+    .vb-recap {
+      margin-top: 12px;
+      font-size: 12.5px;
+      color: var(--rp-e-400);
+
+      &.warn {
+        color: var(--rp-sm-warning);
+        font-weight: 500;
+      }
+    }
+  }
+
+  // scope control (reused OptionsSection) restyled quietly for the light bench
+  .scope-slot {
+    border-radius: 8px;
+    transition: box-shadow 0.2s;
+
+    &.pulse {
+      animation: benchScopePulse 1.6s ease-out;
+    }
+  }
+}
+
+@keyframes benchScopePulse {
+  0% {
+    box-shadow: 0 0 0 0 rgba(0, 176, 209, 0.55);
+  }
+  60% {
+    box-shadow: 0 0 0 6px rgba(0, 176, 209, 0);
+  }
+  100% {
+    box-shadow: 0 0 0 0 rgba(0, 176, 209, 0);
+  }
+}
