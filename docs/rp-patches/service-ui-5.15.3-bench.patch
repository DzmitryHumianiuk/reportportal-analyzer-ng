+/*
+ * The Bench — RP Design System 6 (light) re-skin of the Make Decision modal.
+ * Tokens + values are quoted from docs/consilium-make-decision/mockup-bench-rp.html.
+ * Everything is scoped under .bench-modal so the light surface never leaks into the
+ * surrounding dark modal chrome.
+ */
+
+.bench-modal {
+  // RP Design System 6 tokens (mockup :root)
+  --rp-bg-000: #ffffff;
+  --rp-bg-100: #f7f7f8;
+  --rp-bg-200: #eceff4;
+  --rp-topaz-100: #e5f5f8;
+  --rp-topaz: #00829b;
+  --rp-topaz-hover: #009dbb;
+  --rp-topaz-focused: #00b0d1;
+  --rp-topaz-pressed: #00758c;
+  --rp-almost-black: #3f3f3f;
+  --rp-charcoal: #464547;
+  --rp-e-100: #e3e7ec;
+  --rp-e-200: #c1c7d0;
+  --rp-e-300: #a2aab5;
+  --rp-e-400: #8d95a1;
+  --rp-error: #dc5959;
+  --rp-a-red-700: #c33c3d;
+  --rp-yellow-800: #ffc208;
+  --rp-yellow-700: #d4a002;
+  --rp-sm-warning: #d78706;
+  --rp-sm-warning-line-100: #fceecb;
+  --rp-sm-warning-line-200: #fbe7b6;
+  --rp-status-passed: #3aa76d;
+  --rp-a-green-800: #1c8b50;
+  --rp-shadow-rgb: 55, 67, 98;
+  --rp-shadow: 0 1px 3px rgba(var(--rp-shadow-rgb), 0.1);
+  --rp-shadow-hover: 0 1px 3px rgba(var(--rp-shadow-rgb), 0.2);
+  --rp-shadow-secondary: 0 8px 40px rgba(0, 0, 0, 0.15);
+  --rp-font: Roboto, Arial, Helvetica, sans-serif;
+  --rp-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
+  --muted3: #8d95a1;
+
+  min-width: 1080px;
+  max-width: 1240px;
+  margin: 0 auto 10px auto;
+  background: var(--rp-bg-000);
+  border-radius: 16px;
+  overflow: hidden;
+  box-shadow: var(--rp-shadow-secondary);
+  border: 1px solid var(--rp-e-100);
+  font-family: var(--rp-font);
+  color: var(--rp-almost-black);
+  font-size: 13px;
+  line-height: 20px;
+
+  a {
+    color: var(--rp-topaz);
+  }
+
+  // ---- shared bits -------------------------------------------------------
+  .insp-link {
+    display: inline-flex;
+    align-items: center;
+    gap: 3px;
+    color: var(--rp-topaz);
+    text-decoration: none;
+    font-size: 12px;
+    white-space: nowrap;
+
+    &:hover {
+      text-decoration: underline;
+    }
+
+    // RP open-in-new-tab icon: inherit the link color, sit on the text baseline.
+    .insp-ico {
+      display: inline-flex;
+      align-items: center;
+
+      svg {
+        width: 13px;
+        height: 13px;
+
+        path {
+          fill: currentColor;
+        }
+      }
+    }
+
+    // Pinned to the card's top right corner (the .check card is position: relative).
+    &.corner {
+      position: absolute;
+      top: 10px;
+      right: 12px;
+    }
+  }
+
+  .tip {
+    border-bottom: 1px dotted var(--rp-e-300);
+    cursor: help;
+  }
+
+  .dot {
+    display: inline-block;
+    width: 9px;
+    height: 9px;
+    border-radius: 50%;
+    flex: none;
+  }
+
+  .kbd {
+    display: inline-block;
+    font-family: var(--rp-mono);
+    font-size: 11px;
+    line-height: 16px;
+    padding: 0 5px;
+    background: var(--rp-bg-200);
+    border: 1px solid var(--rp-e-200);
+    border-radius: 3px;
+    color: var(--rp-charcoal);
+  }
+
+  // ---- buttons (§5.1) ----------------------------------------------------
+  .btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    border-radius: 3px;
+    font-size: 13px;
+    line-height: 20px;
+    font-weight: 500;
+    font-family: var(--rp-font);
+    padding: 7px 14px;
+    border: 1px solid transparent;
+    cursor: pointer;
+    background: transparent;
