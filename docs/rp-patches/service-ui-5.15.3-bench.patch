+
+/*
+ * Bench-mode identity bar carried inside the dark ModalHeader title slot.
+ * The dark chrome answers "what am I deciding on": item name, real status,
+ * and the SAVED issue type (the "before" picture). Values are RP entities;
+ * nothing is fabricated.
+ */
+
+.bench-identity {
+  display: flex;
+  align-items: baseline;
+  gap: 14px;
+  min-width: 0;
+  font-family: $FONT-REGULAR;
+}
+
+.bi-cap {
+  flex: none;
+  font-size: 11px;
+  line-height: 16px;
+  font-weight: 600;
+  letter-spacing: 1.2px;
+  text-transform: uppercase;
+  color: $COLOR--darkmode-gray-150;
+}
+
+.bi-name {
+  font-size: 16px;
+  line-height: 22px;
+  color: $COLOR--white-two;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.bi-status {
+  flex: none;
+  font-size: 11px;
+  line-height: 16px;
+  letter-spacing: 0.6px;
+  text-transform: uppercase;
+  color: $COLOR--darkmode-gray-100;
+}
+
+.bi-issue {
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 12px;
+  line-height: 16px;
+  color: $COLOR--darkmode-gray-100;
+}
+
+.bi-dot {
+  display: inline-block;
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  flex: none;
+}
+
+/*
+ * Bench loading placeholder: shown while the analyzer suggest reply is in flight,
+ * in place of the stock tabs, so the old Make Decision never flashes before the
+ * Bench mounts. Same light surface + footprint as the Bench so the shell does not
+ * jump when the real content arrives.
+ */
+.bench-pending {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 1080px;
+  max-width: 1240px;
+  min-height: 320px;
+  margin: 0 auto 10px auto;
+  background: #ffffff;
+  border: 1px solid #e3e7ec;
+  border-radius: 16px;
+  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.15);
+}
