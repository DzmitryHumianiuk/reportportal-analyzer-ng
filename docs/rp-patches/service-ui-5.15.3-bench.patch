+        align-items: center;
+      }
+    }
+    // The Enter hint hugs the banner's right edge (mockup parity).
+    .headline-help {
+      font-size: 12.5px;
+      color: var(--rp-e-400);
+      margin-left: auto;
+      text-align: right;
+      white-space: nowrap;
+
+      .kbd {
+        margin: 0 2px;
+      }
+    }
+  }
+  .region-cap {
+    font-size: 11px;
+    font-weight: 700;
+    letter-spacing: 0.4px;
+    text-transform: uppercase;
+    color: var(--rp-e-400);
+    margin-bottom: 10px;
+  }
+  // Offers region head ("What the analyzer offers now"). Copied from the mockup's
+  // .region-cap recipe for the offers band; named hook for the offers section so
+  // the hub agent can label it without overloading the shared .region-cap.
+  .offers-cap {
+    font-size: 11px;
+    line-height: 16px;
+    font-weight: 700;
+    letter-spacing: 0.8px;
+    text-transform: uppercase;
+    color: var(--rp-e-400);
+    margin: 0 0 9px;
+  }
+  .bench-row {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: stretch;
+    gap: 14px;
+  }
+
+  // ---- advisor check cards ----------------------------------------------
+  .check {
+    // Narrower basis so three cards + the vertical divider + the dock column all
+    // sit on ONE row (mockup-bench.html), never wrapping the dock to a second row.
+    flex: 1 1 190px;
+    min-width: 180px;
+    max-width: 320px;
+    background: var(--rp-bg-000);
+    border: 1px solid var(--rp-e-200);
+    border-radius: 8px;
+    padding: 12px 13px 12px 15px;
+    position: relative;
+    box-shadow: var(--rp-shadow);
+    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
+
+    // Mockup parity (mockup-mdm-states .check:hover): the WHOLE card is the arm
+    // target, so an actionable card shows a pointer and lifts on hover to invite
+    // the click. Empty cards stay inert.
+    &.actionable {
+      cursor: pointer;
+
+      &:hover {
+        border-color: var(--rp-e-300);
+        box-shadow: var(--rp-shadow-hover, 0 1px 3px rgba(9, 30, 66, 0.2));
+      }
+      &:focus-visible {
+        outline: none;
+        border-color: var(--rp-topaz);
+        box-shadow: 0 0 0 2px var(--rp-topaz-focused);
+      }
+    }
+    &.empty {
+      cursor: default;
+    }
+
+    // Mockup parity: the compare-source card carries a topaz focus ring while
+    // its compare view is open (mockup-bench-rp.html .check.focus).
+    &.focus {
+      border-color: var(--rp-topaz);
+      box-shadow: 0 0 0 1px var(--rp-topaz-focused) inset;
+    }
+
+    // Stage 2 (verdict 6.1): the armed card keeps a persistent topaz ring so the
+    // human can always see which advisor is loaded into the verdict. Stronger
+    // than the compare focus ring and the hover lift, listed after both so armed
+    // wins (mockup-mdm-states .ms.armed .check.lead).
+    &.armed,
+    &.armed.focus,
+    &.actionable.armed:hover {
+      border-color: var(--rp-topaz);
+      box-shadow: 0 0 0 2px var(--rp-topaz-focused), var(--rp-shadow);
+    }
+
+    // Arming an offer the model refused must not look like arming one it backs.
+    // The ring turns amber and beats ONCE. A looping blink was considered and
+    // dropped: in a project still filling up this is the ordinary state, and a
+    // warning that never stops moving is furniture by the third item, harder to
+    // read while it moves, and a problem for anyone sensitive to motion. One beat
+    // at the moment of arming, then a stable warning colour that stays.
+    &.armed.armed-unbacked,
+    &.armed.armed-unbacked.focus,
+    &.actionable.armed.armed-unbacked:hover {
+      border-color: #d9a441;
+      box-shadow: 0 0 0 2px rgba(217, 164, 65, 0.55), var(--rp-shadow);
+      animation: bench-armed-warn 460ms ease-out 1;
+    }
+
+    @keyframes bench-armed-warn {
+      0% {
+        box-shadow: 0 0 0 2px rgba(217, 164, 65, 0.55), var(--rp-shadow);
+      }
+      45% {
+        box-shadow: 0 0 0 7px rgba(217, 164, 65, 0.28), var(--rp-shadow);
+      }
+      100% {
+        box-shadow: 0 0 0 2px rgba(217, 164, 65, 0.55), var(--rp-shadow);
+      }
+    }
+
+    // The colour carries the warning on its own; the beat only draws the eye at
+    // the moment of arming, so dropping it costs nothing.
+    @media (prefers-reduced-motion: reduce) {
+      &.armed.armed-unbacked,
+      &.armed.armed-unbacked.focus,
+      &.actionable.armed.armed-unbacked:hover {
+        animation: none;
+      }
+    }
+
+    // The "leading" chip in the method header (mockup .lean-chip): marks the card
+    // a bare Enter arms first.
+    .lean-chip {
+      display: inline-flex;
+      align-items: center;
+      margin-left: 6px;
+      padding: 1px 8px;
+      border: 1px solid var(--rp-topaz);
+      border-radius: 100px;
+      background: var(--rp-topaz-100);
+      color: var(--rp-topaz-pressed);
+      font-size: 10px;
+      font-weight: 700;
+      letter-spacing: 0.4px;
+      text-transform: uppercase;
+      cursor: help;
+
+      // Whether the model stands behind the offer. "Not backed" replaces the
+      // leading chip rather than sitting next to it: a card the model declined
+      // must not also wear the badge that says it leads.
+      &.unbacked {
+        border-color: #d9b382;
+        background: #fdf4e6;
+        color: #8a5a00;
+      }
+
+      &.backed {
+        border-color: #a9d3ba;
+        background: #eef7f1;
+        color: #2b6b47;
+      }
+    }
+    // The model's own verdict on the offer above it. Reads as a caption, not as
+    // a second headline: the defect pill stays the loudest thing on the card.
