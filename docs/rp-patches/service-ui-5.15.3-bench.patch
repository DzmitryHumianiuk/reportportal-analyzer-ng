@@ -0,0 +1,992 @@
+/*
+ * Copyright 2025 EPAM Systems
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * The Bench: a data-driven re-skin of the Make Decision execution/suggestions area.
+ * It reads the SAME live data the stock modal already loads (currentTestItems[0].logs
+ * from bulkLastLogs, suggestedItems from URLS.MLSuggestions) and commits through the
+ * SAME wire-identical path (selectManualChoice / suggestChoice + applyChanges), so no
+ * analyzer round-trip or save behaviour changes. Only the presentation and the way a
+ * decision is reached are new. See docs/consilium-make-decision/mockup-bench-rp.html.
+ */
+
+import React, { useEffect, useMemo, useRef, useState } from 'react';
+import PropTypes from 'prop-types';
+import classNames from 'classnames/bind';
+import { useIntl } from 'react-intl';
+import { useSelector } from 'react-redux';
+import { getDefectTypeSelector } from 'controllers/project';
+import { projectInfoIdSelector } from 'controllers/project/selectors';
+import { DefectTypeItem } from 'pages/inside/common/defectTypeItem';
+import { DefectTypeSelector } from 'pages/inside/common/defectTypeSelector';
+import { MarkdownEditor } from 'components/main/markdown';
+import { ENTER_KEY_CODE, ESCAPE_KEY_CODE } from 'common/constants/keyCodes';
+import { messages } from '../messages';
+import {
+  ACTIVE_TAB_MAP,
+  ERROR_LOGS_SIZE,
+  MACHINE_LEARNING_SUGGESTIONS,
+  SELECT_DEFECT_MANUALLY,
+} from '../constants';
+import {
+  BANDS,
+  getInspectorJourneyUrl,
+  getInspectorJourneyUrlForItem,
+  isRubricHypothesis,
+  parseBand,
+  parseConfidence,
+  parseExplanation,
+  parseExplKind,
+  parseNgVersion,
+  parseProvenance,
+} from '../analyzerSuggestionMeta';
+import styles from './bench.scss';
+
+const cx = classNames.bind(styles);
+
+// ---- log helpers (client-side v1 raw-line diff, tokens masked for ALIGNMENT only) ----
+const toLines = (logs) =>
+  (logs || [])
+    .slice(0, ERROR_LOGS_SIZE)
+    .flatMap((log) =>
+      (log.message || '')
+        .split('\n')
+        .filter((t) => t.length)
+        .map((text) => ({ text, id: log.id })),
+    );
+
+const normalizeLine = (line) =>
+  line
+    .replace(/\b0x[0-9a-f]+\b/gi, '0xHEX')
+    .replace(/\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/gi, 'UUID')
+    .replace(/\d{4}-\d{2}-\d{2}[ t]\d{2}:\d{2}:\d{2}[.\d]*/gi, 'TS')
+    .replace(/:\d+/g, ':N')
+    .replace(/\d+/g, 'N')
+    .replace(/\s+/g, ' ')
+    .trim();
+
+const scoreToAlike = (matchScore) =>
+  typeof matchScore === 'number' ? (matchScore / 100).toFixed(2) : '';
+
+const InspectorLink = ({ href, label }) =>
+  href ? (
+    <a className={cx('insp-link')} href={href} target="_blank" rel="noopener noreferrer">
+      {label} <span aria-hidden>↗</span>
+    </a>
+  ) : null;
+InspectorLink.propTypes = { href: PropTypes.string, label: PropTypes.string };
+InspectorLink.defaultProps = { href: null, label: '' };
+
+export const Bench = ({
+  suggestedItems,
+  currentItem,
+  modalState,
+  setModalState,
+  activeTab,
+  setActiveTab,
+  onApply,
+  modalHasChanges,
+  onAdoptRubric,
+  scopeSection,
+  scopeRef,
+  isBulkOperation,
+}) => {
+  const { formatMessage } = useIntl();
+  const getDefectType = useSelector(getDefectTypeSelector);
+  const projectId = useSelector(projectInfoIdSelector);
+
+  const [compare, setCompare] = useState(null); // { res, logs, suggestRs } | null
+  const [logOpen, setLogOpen] = useState(false);
+  const [groupOpen, setGroupOpen] = useState(false);
+  const [dockOpen, setDockOpen] = useState(true);
+  const [focusDock, setFocusDock] = useState(null);
+  const [dockHighlight, setDockHighlight] = useState(''); // defect longName (lower) or ''
+  const [verdictProv, setVerdictProv] = useState(null); // {key, params}
+  const [commentChecked, setCommentChecked] = useState(true);
+  const [prefillNote, setPrefillNote] = useState(false);
+  const [commentKey, setCommentKey] = useState(0); // forces MarkdownEditor re-mount on prefill
+
+  const defectName = (locator) => getDefectType(locator)?.longName || locator || '';
+  const defectColor = (locator) => getDefectType(locator)?.color || '#76839b';
+
+  // ---- classify the analyzer rows into the three checks --------------------
+  const parsed = useMemo(
+    () =>
+      (suggestedItems || []).map((s) => ({
+        res: s.testItemResource,
+        logs: s.logs,
+        suggestRs: s.suggestRs,
+        band: parseBand(s.suggestRs),
+        rubric: isRubricHypothesis(s.suggestRs),
+        issueType: s.suggestRs.issueType,
+        score: s.suggestRs.matchScore,
+        conf: parseConfidence(s.suggestRs),
+        explanation: parseExplanation(s.suggestRs),
+        explKind: parseExplKind(s.suggestRs),
+        provenance: parseProvenance(s.suggestRs),
+        ng: parseNgVersion(s.suggestRs),
+      })),
+    [suggestedItems],
+  );
+
+  const rubricRow = parsed.find((p) => p.rubric) || null;
+  const classical = parsed.filter((p) => !p.rubric);
+  const autoRow = classical.find((p) => p.band === BANDS.AUTO) || null;
+  const suggestRows = classical.filter((p) => p.band === BANDS.SUGGEST);
+  const belowRows = classical.filter((p) => p.band === BANDS.BELOW_SUGGEST);
+  const precedentRow = autoRow;
+  const topSuggest = suggestRows[0] || null;
+
+  // agreement state (S1 agree / S2 disagree / S3 cold-start / S4 not sure)
+  const classicalAnswer = autoRow ? autoRow.issueType : topSuggest ? topSuggest.issueType : null;
+  let state;
+  if (classicalAnswer) {
+    const suggestDefects = new Set(suggestRows.map((r) => r.issueType));
+    const split =
+      suggestDefects.size > 1 || (rubricRow && rubricRow.issueType !== classicalAnswer);
+    state = split ? 'disagree' : 'agree';
+  } else if (rubricRow && belowRows.length === 0) {
+    state = 'coldstart';
+  } else {
+    state = 'notsure';
+  }
+
+  // ---- the current verdict (the choice that Apply will send) ---------------
+  const activeChoice = modalState[ACTIVE_TAB_MAP[activeTab]] || {};
+  const currentIssue = activeChoice.issue || {};
+
+  // ---- group of identical failures (same-signature TI twins in this run) ---
+  const groupMembers = modalState.testItems || [];
+  const groupCount = groupMembers.length + 1;
+  const showGroup = !isBulkOperation && groupCount > 1;
+
+  // ---- gestures ------------------------------------------------------------
+  const bumpComment = () => setCommentKey((k) => k + 1);
+
+  const adoptClassical = (row) => {
+    const explanation = row.explanation || '';
+    setModalState({
+      ...modalState,
+      decisionType: MACHINE_LEARNING_SUGGESTIONS,
+      issueActionType: '',
+      suggestChoice: {
+        ...row.res,
+        logs: row.logs,
+        suggestRs: row.suggestRs,
+        issue: {
+          ...(row.res.issue || {}),
+          issueType: row.issueType,
+          comment: explanation || row.res.issue?.comment || '',
+        },
+      },
+    });
+    setActiveTab(MACHINE_LEARNING_SUGGESTIONS);
+    setDockHighlight('');
+    setCommentChecked(!!explanation);
+    setPrefillNote(!!explanation);
+    setVerdictProv(
+      row.band === BANDS.AUTO
+        ? { key: 'benchProvFromPrecedent' }
+        : { key: 'benchProvFromSimilarity', params: { score: scoreToAlike(row.score) } },
+    );
+    bumpComment();
+  };
+
+  const adoptRubric = (row) => {
+    onAdoptRubric({ issueType: row.issueType, comment: row.explanation || '' });
+    setActiveTab(SELECT_DEFECT_MANUALLY);
+    setDockHighlight('');
+    setCommentChecked(true);
+    setPrefillNote(!!row.explanation);
+    setVerdictProv({ key: 'benchProvFromAi' });
+    bumpComment();
+  };
+
+  const selectManual = (issueType) => {
+    const base =
+      modalState.decisionType === SELECT_DEFECT_MANUALLY
+        ? modalState.selectManualChoice.issue
+        : currentItem?.issue || {};
+    setModalState({
+      ...modalState,
+      decisionType: SELECT_DEFECT_MANUALLY,
+      issueActionType: '',
+      selectManualChoice: { issue: { ...base, issueType } },
+    });
+    setActiveTab(SELECT_DEFECT_MANUALLY);
+    setDockHighlight('');
+    setPrefillNote(false);
+    setVerdictProv({ key: 'benchProvYouPicked', picked: true });
+  };
+
+  const dockAdopt = (row, e) => {
+    e && e.stopPropagation();
+    // highlight-only: never selects a defect the analyzer said no to. Apply stays
+    // disabled until the human explicitly clicks the highlighted type (Enter can't fire).
+    setModalState({
+      ...modalState,
+      decisionType: SELECT_DEFECT_MANUALLY,
+      issueActionType: '',
+      selectManualChoice: { issue: { ...(currentItem?.issue || {}) } },
+    });
+    setActiveTab(SELECT_DEFECT_MANUALLY);
+    setDockHighlight(defectName(row.issueType).toLowerCase());
+    setPrefillNote(false);
+    setVerdictProv({ key: 'benchProvDockAdopt' });
+  };
+
+  const setComment = (value) => {
+    const comment = (value || '').trim();
+    if (activeTab === MACHINE_LEARNING_SUGGESTIONS) {
+      setModalState({
+        suggestChoice: {
+          ...modalState.suggestChoice,
+          issue: { ...(modalState.suggestChoice.issue || {}), comment },
+        },
+      });
+    } else {
+      setModalState({
+        decisionType: SELECT_DEFECT_MANUALLY,
+        selectManualChoice: {
+          issue: { ...(modalState.selectManualChoice.issue || {}), comment },
+        },
+      });
+    }
+  };
+
+  const openCompare = (row) => {
+    setFocusDock(null);
+    setCompare(row);
+  };
+  const closeCompare = () => setCompare(null);
+
+  // ---- keyboard: Enter applies (outside editor); Esc closes compare first ---
+  useEffect(() => {
+    const handler = (e) => {
+      const inEditor =
+        e.target &&
+        (['INPUT', 'TEXTAREA'].includes(e.target.tagName) ||
+          e.target.isContentEditable ||
+          (e.target.closest && e.target.closest('.CodeMirror')));
+      if (e.keyCode === ESCAPE_KEY_CODE && compare) {
+        // Esc closes the compare view, NOT the modal. Beat DarkModalLayout's
+        // bubble-phase document handler by stopping the event in the capture phase.
+        e.stopImmediatePropagation();
+        e.preventDefault();
+        closeCompare();
+        return;
+      }
+      if (
+        e.keyCode === ENTER_KEY_CODE &&
+        !e.ctrlKey &&
+        !e.metaKey &&
+        !e.shiftKey &&
+        !inEditor &&
+        modalHasChanges
+      ) {
+        e.preventDefault();
+        onApply();
+      }
+    };
+    document.addEventListener('keydown', handler, true);
+    return () => document.removeEventListener('keydown', handler, true);
+  }, [compare, modalHasChanges, onApply]);
+
+  const pulseScope = () => {
+    const node = scopeRef && scopeRef.current;
+    if (!node) return;
+    node.classList.remove(cx('pulse'));
+    // force reflow so the animation restarts
+    // eslint-disable-next-line no-unused-expressions
+    node.offsetWidth;
+    node.classList.add(cx('pulse'));
+    node.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+    setTimeout(() => node.classList.remove(cx('pulse')), 1700);
+  };
+
+  // ---- render helpers ------------------------------------------------------
+  const errorLines = toLines(currentItem?.logs);
+  const headerLine = errorLines[0]?.text || '';
+  const restLines = errorLines.slice(1);
+
+  const renderPill = (locator) =>
+    locator ? <DefectTypeItem type={locator} className={cx('defect-pill')} /> : null;
+
+  const renderCheck = ({ kind }) => {
+    if (kind === 'past') {
+      if (precedentRow) {
+        return (
+          <div className={cx('check', 'auto')}>
+            <span className={cx('edge')} />
+            <div className={cx('method')}>
+              <span className={cx('gl')}>◆</span> {formatMessage(messages.benchCheckPast)}
+            </div>
+            <div className={cx('role')}>{formatMessage(messages.benchCheckPastRole)}</div>
+            <div className={cx('verd-pill')}>{renderPill(precedentRow.issueType)}</div>
+            <div className={cx('strength')}>{formatMessage(messages.benchCheckPastStrong)}</div>
+            <button
+              type="button"
+              className={cx('btn', 'btn-ghost', 'btn-sm', 'compare-btn')}
+              onClick={() => openCompare(precedentRow)}
+            >
+              {formatMessage(messages.benchCompareLogs)}
+            </button>
+          </div>
+        );
+      }
+      return (
+        <div className={cx('check', 'empty')}>
+          <span className={cx('edge')} />
+          <div className={cx('method')}>
+            <span className={cx('gl')}>◆</span> {formatMessage(messages.benchCheckPast)}
+          </div>
+          <div className={cx('strength')}>{formatMessage(messages.benchCheckPastNoMatch)}</div>
+          <div className={cx('prov')}>{formatMessage(messages.benchCheckPastNoMatchProv)}</div>
+        </div>
+      );
+    }
+    if (kind === 'similar') {
+      if (topSuggest) {
+        return (
+          <div className={cx('check', 'suggest')}>
+            <span className={cx('edge')} />
+            <InspectorLink
+              href={getInspectorJourneyUrl(topSuggest.suggestRs)}
+              label={formatMessage(messages.benchWhy)}
+            />
+            <div className={cx('method')}>
+              <span className={cx('gl')}>≈</span> {formatMessage(messages.benchCheckSimilar)}
+            </div>
+            <div className={cx('role')}>{formatMessage(messages.benchCheckSimilarRole)}</div>
+            <div className={cx('verd-pill')}>{renderPill(topSuggest.issueType)}</div>
+            <div className={cx('strength')}>
+              <b>{formatMessage(messages.benchAlike, { score: scoreToAlike(topSuggest.score) })}</b>{' '}
+              {formatMessage(messages.benchBandSuggest)}
+            </div>
+            <button
+              type="button"
+              className={cx('btn', 'btn-ghost', 'btn-sm', 'compare-btn')}
+              onClick={() => openCompare(topSuggest)}
+            >
+              {formatMessage(messages.benchCompareLogs)}
+            </button>
+          </div>
+        );
+      }
+      if (belowRows.length) {
+        return (
+          <div className={cx('check', 'abstain')}>
+            <span className={cx('edge')} />
+            <div className={cx('method')}>
+              <span className={cx('gl')}>≈</span> {formatMessage(messages.benchCheckSimilar)}
+            </div>
+            <div className={cx('role')}>{formatMessage(messages.benchCheckSimilarRole)}</div>
+            <div className={cx('strength')}>
+              <b>{formatMessage(messages.benchAlike, { score: scoreToAlike(belowRows[0].score) })}</b>{' '}
+              {formatMessage(messages.benchBandAbstain)}
+            </div>
+            <div className={cx('prov')}>{formatMessage(messages.benchDockNote)}</div>
+          </div>
+        );
+      }
+      return (
+        <div className={cx('check', 'empty')}>
+          <span className={cx('edge')} />
+          <div className={cx('method')}>
+            <span className={cx('gl')}>≈</span> {formatMessage(messages.benchCheckSimilar)}
+          </div>
+          <div className={cx('strength')}>{formatMessage(messages.benchCheckSimilarNone)}</div>
+        </div>
+      );
+    }
+    // AI guess
+    if (rubricRow) {
+      const pct = rubricRow.conf != null ? Math.round(rubricRow.conf * 100) : Math.round(rubricRow.score);
+      return (
+        <div className={cx('check', 'rubric')}>
+          <span className={cx('edge')} />
+          <InspectorLink
+            href={getInspectorJourneyUrl(rubricRow.suggestRs)}
+            label={formatMessage(messages.benchWhy)}
+          />
+          <div className={cx('method')}>
+            <span className={cx('gl')}>✦</span> {formatMessage(messages.benchCheckAi)}
+            <span className={cx('tag-nc')}>{formatMessage(messages.benchNotConfirmed)}</span>
+          </div>
+          <div className={cx('role')}>{formatMessage(messages.benchCheckAiRole)}</div>
+          <div className={cx('verd-pill')}>{renderPill(rubricRow.issueType)}</div>
+          <div className={cx('strength')}>{formatMessage(messages.benchAiGuessPct, { pct })}</div>
+          <button
+            type="button"
+            className={cx('btn', 'btn-ghost', 'btn-sm', 'compare-btn')}
+            onClick={() => adoptRubric(rubricRow)}
+          >
+            {formatMessage(messages.benchUseThisGuess)}
+          </button>
+        </div>
+      );
+    }
+    return (
+      <div className={cx('check', 'empty')}>
+        <span className={cx('edge')} />
+        <div className={cx('method')}>
+          <span className={cx('gl')}>✦</span> {formatMessage(messages.benchCheckAi)}
+        </div>
+        <div className={cx('strength')}>{formatMessage(messages.benchCheckAiNone)}</div>
+      </div>
+    );
+  };
+
+  const renderDock = () => {
+    if (!belowRows.length) return null;
+    return (
+      <div className={cx('dock')}>
+        <div
+          className={cx('dock-toggle', { open: dockOpen })}
+          onClick={() => setDockOpen((o) => !o)}
+          role="button"
+          tabIndex={0}
+        >
+          <span className={cx('chev')}>▼</span>
+          {formatMessage(messages.benchDockToggle, { count: belowRows.length })}
+        </div>
+        {dockOpen && (
+          <div className={cx('dock-body')}>
+            <div className={cx('dock-note')}>{formatMessage(messages.benchDockNote)}</div>
+            {belowRows.map((row) => (
+              <div
+                key={row.res.id}
+                className={cx('dock-item', { focus: focusDock === row.res.id })}
+                onClick={() => {
+                  setFocusDock(row.res.id);
+                  openCompare(row);
+                }}
+                role="button"
+                tabIndex={0}
+              >
+                <div className={cx('dn')}>{row.res.name}</div>
+                <div className={cx('dd')}>
+                  <span className={cx('strike')}>{defectName(row.issueType)}</span>{' '}
+                  {formatMessage(messages.benchDockTooWeak, { score: scoreToAlike(row.score) })}
+                </div>
+                <div className={cx('dact')}>
+                  <button
+                    type="button"
+                    className={cx('dock-adopt')}
+                    onClick={(e) => dockAdopt(row, e)}
+                  >
+                    {formatMessage(messages.benchDockChoose)}
+                  </button>
+                  <InspectorLink
+                    href={getInspectorJourneyUrl(row.suggestRs)}
+                    label={formatMessage(messages.benchWhy)}
+                  />
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    );
+  };
+
+  // The group of identical failures as first-class LEFT-column context (ng3).
+  const renderGroup = () => {
+    if (!showGroup) {
+      return (
+        <div className={cx('group-alone')}>
+          <span className={cx('ga-glyph')} aria-hidden>
+            ●
+          </span>
+          <div>
+            <b>{formatMessage(messages.benchGroupAloneTitle)}</b>
+            <br />
+            {formatMessage(messages.benchGroupAloneSub)}
+          </div>
+        </div>
+      );
+    }
+    return (
+      <div className={cx('group-block')}>
+        <div className={cx('group-line')}>
+          <span className={cx('group-badge')}>{groupCount}</span>
+          <div className={cx('group-main')}>
+            <div className={cx('group-head')}>
+              {formatMessage(messages.benchGroupHead, {
+                count: groupCount,
+                b: (chunks) => <b key="b">{chunks}</b>,
+              })}
+            </div>
+            <div className={cx('group-sub')}>{formatMessage(messages.benchGroupSub)}</div>
+          </div>
+        </div>
+        <div className={cx('group-actions')}>
+          <button
+            type="button"
+            className={cx('btn', 'btn-ghost', 'btn-sm')}
+            onClick={() => setGroupOpen((o) => !o)}
+          >
+            {formatMessage(groupOpen ? messages.benchGroupHideTests : messages.benchGroupShowTests)}
+          </button>
+        </div>
+        <button type="button" className={cx('group-pointer')} onClick={pulseScope}>
+          {formatMessage(messages.benchGroupPointer, { count: groupCount })} <span aria-hidden>↓</span>
+        </button>
+        {groupOpen && (
+          <div className={cx('group-members')}>
+            <div className={cx('gm-list')}>
+              <span className={cx('gm-chip')}>
+                <span
+                  className={cx('dot')}
+                  style={{ background: defectColor(currentIssue.issueType) }}
+                />
+                {currentItem?.name}{' '}
+                <span className={cx('gm-cur')}>{formatMessage(messages.benchGroupThisTest)}</span>
+              </span>
+              {groupMembers.map((m) => (
+                <span key={m.id || m.itemId} className={cx('gm-chip')}>
+                  <span
+                    className={cx('dot')}
+                    style={{ background: defectColor(m.issue?.issueType) }}
+                  />
+                  {m.name}
+                </span>
+              ))}
+            </div>
+            <div className={cx('gm-foot')}>
+              <InspectorLink
+                href={itemInspector}
+                label={formatMessage(messages.benchGroupInspector)}
+              />
+            </div>
+          </div>
+        )}
+      </div>
+    );
+  };
+
+  const renderAiStrip = (row, capMessage, guess) => {
+    if (!row || !row.explanation) return null;
+    return (
+      <div className={cx('ai-strip', { guess })}>
+        <div className={cx('ai-cap')}>
+          <span>{formatMessage(capMessage)}</span>
+          <InspectorLink
+            href={getInspectorJourneyUrl(row.suggestRs)}
+            label={formatMessage(messages.benchInspectorReason)}
+          />
+        </div>
+        <div className={cx('ai-text')}>{row.explanation}</div>
+        {guess && (
+          <div className={cx('review-note')}>{formatMessage(messages.benchStageReviewNote)}</div>
+        )}
+      </div>
+    );
+  };
+
+  const renderStage = () => {
+    if (compare) return renderCompare();
+    if (state === 'agree') {
+      const winner = precedentRow || topSuggest;
+      const matchLine = toLines(winner?.logs)[0]?.text;
+      return (
+        <>
+          <div className={cx('region-cap')}>{formatMessage(messages.benchStageCap)}</div>
+          <div className={cx('verdict-line')}>
+            <b>{defectName(classicalAnswer)}</b>.
+          </div>
+          {matchLine && (
+            <div className={cx('vcol')}>
+              <h4>{formatMessage(messages.benchStageMatched)}</h4>
+              <div className={cx('difflog')}>{matchLine}</div>
+              <div className={cx('prov-line')}>
+                <InspectorLink
+                  href={getInspectorJourneyUrl(winner.suggestRs)}
+                  label={formatMessage(messages.benchWhy)}
+                />
+              </div>
+            </div>
+          )}
+          {renderAiStrip(winner, messages.benchStageAgreeCap, false)}
+        </>
+      );
+    }
+    if (state === 'coldstart') {
+      return (
+        <>
+          <div className={cx('region-cap')}>{formatMessage(messages.benchStageCap)}</div>
+          <div className={cx('verdict-line')}>
+            {formatMessage(messages.benchStageColdStartLine)}
+          </div>
+          {renderAiStrip(rubricRow, messages.benchStageAiGuessCap, true)}
+        </>
+      );
+    }
+    if (state === 'disagree') {
+      return (
+        <>
+          <div className={cx('region-cap')}>{formatMessage(messages.benchStageCap)}</div>
+          {renderAiStrip(topSuggest || precedentRow, messages.benchStageAgreeCap, false)}
+          {renderAiStrip(rubricRow, messages.benchStageAiGuessCap, true)}
+        </>
+      );
+    }
+    // not sure
+    return (
+      <>
+        <div className={cx('region-cap')}>{formatMessage(messages.benchStageCap)}</div>
+        <div className={cx('ns-big')}>{formatMessage(messages.benchStageNotSureBig)}</div>
+        <div className={cx('ns-sub')}>{formatMessage(messages.benchStageNotSureSub)}</div>
+        {renderAiStrip(rubricRow, messages.benchStageAiGuessCap, true)}
+        {belowRows[0] &&
+          belowRows[0].explKind === 'decline' &&
+          renderAiStrip(belowRows[0], messages.benchStageDeclineCap, true)}
+      </>
+    );
+  };
+
+  const renderCompare = () => {
+    const leftLines = toLines(currentItem?.logs);
+    const rightLines = toLines(compare.logs);
+    const relevantLogId = compare.suggestRs?.relevantLogId;
+    const leftNorms = new Set(leftLines.map((l) => normalizeLine(l.text)));
+    const rightNorms = new Set(rightLines.map((l) => normalizeLine(l.text)));
+    const left = leftLines.map((l) => ({ ...l, same: rightNorms.has(normalizeLine(l.text)) }));
+    const right = rightLines.map((l) => ({
+      ...l,
+      same: leftNorms.has(normalizeLine(l.text)),
+      star: relevantLogId != null && l.id === relevantLogId,
+    }));
+    const sameCount = right.filter((l) => l.same).length;
+    const diffCount = right.length - sameCount;
+    return (
+      <div className={cx('compare')}>
+        <div className={cx('cmp-head')}>
+          <span className={cx('cmp-title')}>{formatMessage(messages.benchCmpTitle)}</span>
+          <button type="button" className={cx('btn', 'btn-ghost', 'btn-sm')} onClick={closeCompare}>
+            {formatMessage(messages.benchCmpClose)}
+          </button>
+        </div>
+        <div className={cx('cmp-help')}>
+          <span>{formatMessage(messages.benchCmpHelp)}</span>
+          <span className={cx('cmp-legend')}>
+            <span className={cx('lg')}>
+              <span className={cx('sw', 'lg-same')} /> {formatMessage(messages.benchCmpSame)}
+            </span>
+            <span className={cx('lg')}>
+              <span className={cx('sw', 'lg-diff')} /> {formatMessage(messages.benchCmpDiff)}
+            </span>
+          </span>
+        </div>
+        <div className={cx('cmp-cols')}>
+          <div className={cx('cmp-col', 'left')}>
+            <div className={cx('cmp-col-head')}>
+              {formatMessage(messages.benchCmpLeft)}
+              <span className={cx('s')}>{formatMessage(messages.benchCmpLeftSuffix)}</span>
+            </div>
+            <div className={cx('cmp-body')}>
+              {left.map((l, i) => (
+                <div key={i} className={cx('cmp-line', l.same ? 'same' : 'diff')}>
+                  {l.text}
+                  {!l.same && (
+                    <span className={cx('sidetag')}>
+                      {formatMessage(messages.benchCmpOnlyHere)}
+                    </span>
+                  )}
+                </div>
+              ))}
+            </div>
+          </div>
+          <div className={cx('cmp-col', 'right')}>
+            <div className={cx('cmp-col-head')}>
+              {formatMessage(messages.benchCmpRight)}
+              <span className={cx('s')}>{compare.res?.name}</span>
+            </div>
+            <div className={cx('cmp-body')}>
+              {right.length === 0 && (
+                <div className={cx('cmp-nolog')}>{formatMessage(messages.benchCmpNoLog)}</div>
+              )}
+              {right.map((l, i) => (
+                <div key={i} className={cx('cmp-line', l.same ? 'same' : 'diff')}>
+                  {l.star && <span className={cx('starwrap')}>★ {formatMessage(messages.similarLog)}: </span>}
+                  {l.text}
+                  {!l.same && (
+                    <span className={cx('sidetag')}>
+                      {formatMessage(messages.benchCmpOnlyThere)}
+                    </span>
+                  )}
+                </div>
+              ))}
+            </div>
+          </div>
+        </div>
+        <div className={cx('cmp-verdict')}>
+          <div className={cx('cv-line')}>
+            {formatMessage(messages.benchCmpSame)}: {sameCount}. {formatMessage(messages.benchCmpDiff)}: {diffCount}.
+          </div>
+        </div>
+        <div className={cx('cmp-foot')}>
+          <div className={cx('cmp-foot-left')}>
+            <span>{formatMessage(messages.benchCmpNotSame)}</span>
+            <button
+              type="button"
+              className={cx('btn', 'btn-ghost', 'btn-sm')}
+              onClick={() => {
+                closeCompare();
+              }}
+            >
+              {formatMessage(messages.benchCmpManual)}
+            </button>
+          </div>
+          <InspectorLink
+            href={getInspectorJourneyUrl(compare.suggestRs)}
+            label={formatMessage(messages.benchInspectorDetails)}
+          />
+        </div>
+      </div>
+    );
+  };
+
+  // ---- provenance tag ------------------------------------------------------
+  const provTag = verdictProv ? (
+    <span className={cx('prov-tag', { picked: verdictProv.picked })}>
+      {formatMessage(messages[verdictProv.key], verdictProv.params || {})}
+    </span>
+  ) : null;
+
+  const recap =
+    verdictProv && verdictProv.key === 'benchProvDockAdopt'
+      ? { warn: true, text: formatMessage(messages.benchRecapWarnConfirm) }
+      : modalHasChanges
+      ? { warn: false, text: formatMessage(messages.benchRecapThisItem) }
+      : null;
+
+  const bannerClass = state === 'agree' ? 'agree' : 'unsure';
+  const headlineByState = {
+    agree: {
+      main: (
+        <>
+          {formatMessage(messages.benchHeadAgree, { defect: '' })}
+          <span className={cx('verd')}>{defectName(classicalAnswer)}</span>
+        </>
+      ),
+      help: (
+        <>
+          <span className={cx('kbd')}>Enter</span> {formatMessage(messages.benchHeadAgreeHelp)}
+        </>
+      ),
+    },
+    disagree: {
+      main: formatMessage(messages.benchHeadDisagree),
+      help: formatMessage(messages.benchHeadDisagreeHelp),
+    },
+    coldstart: {
+      main: formatMessage(messages.benchHeadColdStart),
+      help: formatMessage(messages.benchHeadColdStartHelp),
+    },
+    notsure: {
+      main: formatMessage(messages.benchHeadNotSure),
+      help: formatMessage(messages.benchHeadNotSureHelp),
+    },
+  };
+
+  const itemInspector = getInspectorJourneyUrlForItem(projectId, currentItem);
+
+  return (
+    <div className={cx('modal-scroll')}>
+    <div className={cx('bench-modal')}>
+      {/* item stripe */}
+      <div className={cx('band', 'band-white', 'stripe')}>
+        <div className={cx('stripe-left')}>
+          <div className={cx('name')} title={currentItem?.name}>
+            {currentItem?.name}
+          </div>
+          <div className={cx('meta')}>
+            <span>· FAILED ·</span>
+            <span className={cx('status-pill')}>
+              <span className={cx('dot')} style={{ background: defectColor(currentIssue.issueType) }} />
+              {defectName(currentIssue.issueType)}
+            </span>
+          </div>
+        </div>
+        <div className={cx('stripe-right')}>
+          <span
+            className={cx('logtoggle', { open: logOpen })}
+            onClick={() => setLogOpen((o) => !o)}
+            role="button"
+            tabIndex={0}
+          >
+            <span className={cx('chev')}>▶</span>
+            {formatMessage(logOpen ? messages.benchHideErrorLog : messages.benchShowErrorLog)}
+          </span>
+          <InspectorLink href={itemInspector} label={formatMessage(messages.benchInspectorItem)} />
+        </div>
+      </div>
+
+      {/* R1 this failure */}
+      <div className={cx('band', 'band-grey', 'failure-panel')}>
+        <div className={cx('fp-line')}>
+          <span className={cx('fp-bar')} />
+          <div className={cx('fp-main')}>
+            <div className={cx('fp-cap')}>{formatMessage(messages.benchThisFailure)}</div>
+            <div className={cx('fp-top')} title={headerLine}>
+              {headerLine || '—'}
+            </div>
+          </div>
+        </div>
+        {logOpen && (
+          <div className={cx('fulllog')}>
+            <div className={cx('lg-cap')}>{formatMessage(messages.benchStackAndContext)}</div>
+            {restLines.length ? (
+              restLines.map((l, i) => (
+                <div key={i} className={cx('logrow')}>
+                  {l.text}
+                </div>
+              ))
+            ) : (
+              <div className={cx('logrow')}>{formatMessage(messages.noLogs)}</div>
+            )}
+          </div>
+        )}
+      </div>
+
+      {/* full-width body: LEFT context column (group) + main bench (ng3) */}
+      <div className={cx('bench-split')}>
+        <aside className={cx('context-col')}>
+          <div className={cx('lp-cap')}>{formatMessage(messages.benchInThisRun)}</div>
+          {renderGroup()}
+        </aside>
+        <div className={cx('bench-main')}>
+          {/* the bench */}
+          <div className={cx('bench-region')}>
+            <div className={cx('region-head', bannerClass)}>
+              <span className={cx('headline')}>{headlineByState[state].main}</span>
+              <span className={cx('headline-help')}>{headlineByState[state].help}</span>
+            </div>
+            <div className={cx('region-cap')}>{formatMessage(messages.benchCap)}</div>
+            <div className={cx('bench-row')}>
+              {renderCheck({ kind: 'past' })}
+              {renderCheck({ kind: 'similar' })}
+              {renderCheck({ kind: 'ai' })}
+              {belowRows.length > 0 && (
+                <div className={cx('bar-sep')}>
+                  <span className={cx('bar-rule')} />
+                  <span
+                    className={cx('bar-lbl', 'tip')}
+                    title={formatMessage(messages.benchLineLabel)}
+                  >
+                    {formatMessage(messages.benchLineLabel)}
+                  </span>
+                  <span className={cx('bar-rule')} />
+                </div>
+              )}
+              {renderDock()}
+            </div>
+          </div>
+
+          {/* evidence stage / compare */}
+          <div className={cx('stage')}>{renderStage()}</div>
+        </div>
+      </div>
+
+      {/* verdict bar (R3) */}
+      <div className={cx('band', 'band-white', 'verdict-bar')}>
+        <div className={cx('vb-top')}>
+          <div className={cx('vb-left')}>
+            <div className={cx('vb-verdict-row')}>
+              <span className={cx('flabel')}>{formatMessage(messages.benchVbDefect)}</span>
+              {currentIssue.issueType ? renderPill(currentIssue.issueType) : null}
+              {provTag}
+            </div>
+            <div className={cx('manual-pane')}>
+              <div className={cx('manual-head')}>
+                <span>{formatMessage(messages.benchManualHead)}</span>
+              </div>
+              <DefectTypeSelector
+                selectDefectType={selectManual}
+                selectedItem={
+                  modalState.decisionType === SELECT_DEFECT_MANUALLY
+                    ? modalState.selectManualChoice.issue.issueType || ''
+                    : currentIssue.issueType || ''
+                }
+                highlightedItem={dockHighlight}
+              />
+              <div className={cx('manual-help')}>{formatMessage(messages.benchManualHelp)}</div>
+            </div>
+            <div className={cx('comment-pane')}>
+              <div className={cx('cmt-head')}>
+                <span>{formatMessage(messages.comment)}</span>
+                <span
+                  className={cx('cmt-check', { off: !commentChecked })}
+                  onClick={() => setCommentChecked((c) => !c)}
+                  role="button"
+                  tabIndex={0}
+                >
+                  <span className={cx('box')}>✓</span>
+                  {formatMessage(messages.benchCmtAddReason)}
+                </span>
+              </div>
+              {prefillNote && (
+                <div className={cx('cmt-prefill-note')}>
+                  {formatMessage(messages.benchCmtPrefillNote)}
+                </div>
+              )}
+              <MarkdownEditor
+                key={commentKey}
+                value={currentIssue.comment || ''}
+                onChange={setComment}
+                placeholder={formatMessage(messages.benchCmtPlaceholder)}
+              />
+            </div>
+            <div className={cx('scope-slot')} ref={scopeRef}>
+              {scopeSection}
+            </div>
+          </div>
+          <div className={cx('vb-actions')}>
+            <div className={cx('vb-keys')}>{formatMessage(messages.benchVbKeys)}</div>
+          </div>
+        </div>
+        {recap && (
+          <div className={cx('vb-recap', { warn: recap.warn })}>{recap.text}</div>
+        )}
+      </div>
+    </div>
+    </div>
+  );
+};
+
+Bench.propTypes = {
+  suggestedItems: PropTypes.array,
+  currentItem: PropTypes.object,
+  modalState: PropTypes.object.isRequired,
+  setModalState: PropTypes.func.isRequired,
+  activeTab: PropTypes.string.isRequired,
+  setActiveTab: PropTypes.func.isRequired,
+  onApply: PropTypes.func.isRequired,
+  modalHasChanges: PropTypes.bool,
+  onAdoptRubric: PropTypes.func.isRequired,
+  scopeSection: PropTypes.node,
+  scopeRef: PropTypes.object,
+  isBulkOperation: PropTypes.bool,
+};
+Bench.defaultProps = {
+  suggestedItems: [],
+  currentItem: {},
+  modalHasChanges: false,
+  scopeSection: null,
+  scopeRef: null,
+  isBulkOperation: false,
+};
