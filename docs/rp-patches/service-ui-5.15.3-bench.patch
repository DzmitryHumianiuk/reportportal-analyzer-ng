+    .src-tag {
+      font-size: 10.5px;
+      color: var(--rp-e-400);
+      border: 1px solid var(--rp-e-200);
+      border-radius: 100px;
+      padding: 1px 8px;
+      white-space: nowrap;
+      font-style: normal;
+    }
+    .story-head {
+      font-size: 16px;
+      line-height: 23px;
+      font-weight: 600;
+      color: var(--rp-almost-black);
+      display: flex;
+      align-items: baseline;
+      gap: 10px;
+      flex-wrap: wrap;
+    }
+    .story-time {
+      font-size: 12px;
+      color: var(--rp-e-400);
+      font-weight: 400;
+      white-space: nowrap;
+    }
+    .story-reason {
+      font-size: 13px;
+      line-height: 20px;
+      color: var(--rp-charcoal);
+      margin-top: 4px;
+      max-width: 860px;
+    }
+    // Muted bridge line (abstain-with-offers states).
+    .story-bridge {
+      font-size: 12.5px;
+      line-height: 19px;
+      color: var(--rp-e-400);
+      margin-top: 6px;
+      max-width: 860px;
+      padding-left: 10px;
+      border-left: 2px solid var(--rp-e-100);
+    }
+    // The AI paragraph, gated by isDecisionFresh; topaz rail + grey fill.
+    .story-ai {
+      margin-top: 11px;
+      border-left: 3px solid var(--rp-topaz);
+      background: var(--rp-bg-100);
+      border-radius: 0 8px 8px 0;
+      padding: 9px 13px;
+      max-width: 860px;
+
+      .ai-caprow {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 10px;
+        margin-bottom: 4px;
