+
+  // ---- defect pill (§5.3) ------------------------------------------------
+  .defect-pill {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    background: var(--rp-bg-000);
+    color: var(--rp-almost-black);
+    border: 1px solid var(--rp-e-200);
+    border-radius: 100px;
+    padding: 2px 9px 2px 7px;
+    font-size: 13px;
+    font-weight: 600;
+
+    .dot {
+      width: 12px;
+      height: 12px;
+    }
+
+    // Inline variant (miniPill): the same RP defect label sitting on a text line,
+    // one notch tighter so it does not tower over the surrounding sentence.
+    &.mini {
+      vertical-align: text-bottom;
+      padding: 1px 8px 1px 6px;
+      font-size: 12px;
+    }
+  }
+
+  // ---- the line (horizontal) + declined dock (full-width strip) ----------
+  // Vertical divider column between the advisor cards and the declined dock
+  // (mockup-bench.html). The rotated label sits ON TOP of the dotted rule (a
+  // white chip breaks the dots behind it) so the divider takes only the label's
+  // width, never an extra rule+gap column.
+  .bar-sep {
+    position: relative;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    min-width: 16px;
+    margin: 0 2px;
+
+    .bar-rule {
+      position: absolute;
+      left: 50%;
+      top: 0;
+      bottom: 0;
+      width: 0;
+      border-left: 2px dotted var(--rp-e-300);
+      transform: translateX(-50%);
+    }
+    .bar-lbl {
+      position: relative;
+      writing-mode: vertical-rl;
+      transform: rotate(180deg);
+      padding: 6px 0;
+      background: var(--rp-bg-000);
+      font-size: 10px;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      color: var(--rp-e-400);
+      white-space: nowrap;
+      cursor: help;
+    }
+  }
+  // Declined dock as the 4th column, aligned to the top of the row.
+  .dock {
+    flex: 1 1 240px;
+    min-width: 236px;
+    max-width: 340px;
+    align-self: flex-start;
+    border: 1px dashed var(--rp-e-300);
+    border-radius: 8px;
+    padding: 11px 13px;
+    background: var(--rp-bg-200);
+
+    .dock-items {
+      display: flex;
+      flex-direction: column;
+      gap: 8px;
+      max-height: 260px;
+      overflow: auto;
+    }
+
+    .dock-toggle {
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      cursor: pointer;
+      font-size: 12.5px;
+      font-weight: 600;
+      color: var(--rp-charcoal);
+      user-select: none;
