+
+      b {
+        font-weight: 700;
+      }
+    }
+    // "In launch #N" line, directly under the defect pill (Past decision card).
+    .past-run {
+      margin-top: 6px;
+      font-size: 12.5px;
+      color: var(--rp-almost-black);
+    }
+    .prov {
+      margin-top: 5px;
+      font-size: 12px;
+      color: var(--rp-e-400);
+
+      .prov-note {
+        font-style: italic;
+      }
+    }
+    .card-actions {
+      display: flex;
+      align-items: center;
+      gap: 8px;
