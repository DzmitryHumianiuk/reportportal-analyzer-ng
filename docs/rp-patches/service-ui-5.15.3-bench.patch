+      }
+    }
+    .tag-nc {
+      display: inline-block;
+      margin-left: 6px;
+      padding: 0 6px;
+      border: 1px solid var(--rp-e-200);
+      border-radius: 3px;
+      font-size: 10px;
+      font-weight: 600;
+      color: var(--rp-e-400);
+      vertical-align: middle;
+    }
+    .role {
+      margin-top: 3px;
+      font-size: 12px;
+      color: var(--rp-e-400);
+    }
+    .verd-pill {
+      margin-top: 9px;
+    }
+    // The model's belief in the defect type on the pill beside it. Muted and on
+    // the pill's own line: it is a footnote to the pill, not a second verdict.
+    .label-p {
+      margin-left: 8px;
+      font-size: 11.5px;
+      color: var(--rp-gray-secondary, #8b94a3);
