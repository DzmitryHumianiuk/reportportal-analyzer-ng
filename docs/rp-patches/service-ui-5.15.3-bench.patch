+    background: var(--rp-bg-000);
+    border: 1px solid var(--rp-e-200);
+    border-radius: 8px;
+    padding: 12px 13px 12px 15px;
+    position: relative;
+    box-shadow: var(--rp-shadow);
+    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
+
+    // Mockup parity (mockup-mdm-states .check:hover): the WHOLE card is the arm
+    // target, so an actionable card shows a pointer and lifts on hover to invite
+    // the click. Empty cards stay inert.
+    &.actionable {
+      cursor: pointer;
+
+      &:hover {
+        border-color: var(--rp-e-300);
+        box-shadow: var(--rp-shadow-hover, 0 1px 3px rgba(9, 30, 66, 0.2));
