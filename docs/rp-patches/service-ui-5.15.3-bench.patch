+      font-weight: 700;
+      letter-spacing: 0.8px;
+      text-transform: uppercase;
+      color: var(--rp-e-400);
+    }
+    // Right cluster of the story caprow: the Inspector link then the provenance tag.
+    .story-caprow-right {
+      display: inline-flex;
+      align-items: center;
+      gap: 12px;
+      flex: none;
+    }
+    // Inline defect pill and item link inside the story headline / AI paragraph.
+    .story-head .defect-pill.mini {
