+    }
+    .armed-note {
+      margin-top: 8px;
+      font-size: 11px;
+      font-weight: 600;
+      color: var(--rp-topaz-pressed);
+    }
+
+    .edge {
+      position: absolute;
+      left: 0;
+      top: 0;
+      bottom: 0;
+      width: 4px;
+      border-radius: 8px 0 0 8px;
+    }
+    &.auto .edge {
