+      font-size: 11px;
+      line-height: 1.45;
+      color: var(--rp-gray-secondary, #8b94a3);
+    }
+    // The armed note at the card foot (mockup .armed-note).
+    .armed-note.warn {
+      color: #8a5a00;
+
+      .armed-warn {
