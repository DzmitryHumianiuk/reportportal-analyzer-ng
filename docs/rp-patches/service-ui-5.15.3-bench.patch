+    display: flex;
+    align-items: flex-start;
+    gap: 14px;
+    padding: 28px 24px;
+
+    .sh-bar {
+      width: 4px;
+      border-radius: 2px;
+      background: var(--rp-e-300);
+      align-self: stretch;
+      flex: none;
+    }
+    .sh-glyph {
+      width: 40px;
+      height: 40px;
+      border-radius: 50%;
+      background: var(--rp-bg-200);
+      color: var(--rp-e-400);
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      flex: none;
+    }
+    .sh-main {
+      max-width: 640px;
+      display: flex;
+      flex-direction: column;
+      gap: 8px;
+    }
+    .sh-cap {
+      font-size: 11px;
+      font-weight: 700;
+      letter-spacing: 0.8px;
+      text-transform: uppercase;
+      color: var(--rp-e-400);
+    }
+    .sh-title {
+      display: inline-flex;
+      align-items: center;
+      gap: 7px;
+      font-size: 17px;
+      line-height: 24px;
+      font-weight: 600;
+      color: var(--rp-almost-black);
+
+      .sh-info {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        width: 15px;
+        height: 15px;
+        border-radius: 50%;
+        border: 1px solid var(--rp-e-300);
+        font-size: 10px;
+        color: var(--rp-e-400);
+        cursor: help;
+      }
+    }
+    .sh-body {
+      font-size: 13px;
+      line-height: 20px;
+      color: var(--rp-charcoal);
+    }
+    .sh-next {
+      font-size: 13px;
+      line-height: 20px;
+      font-weight: 500;
+      color: var(--rp-almost-black);
+    }
+    .sh-note {
+      font-size: 12px;
+      line-height: 18px;
+      color: var(--rp-e-400);
+    }
+  }
+
+  .failure-panel {
+    padding: 12px 24px;
+
+    .fp-line {
+      display: flex;
+      gap: 12px;
+    }
+    .fp-bar {
+      width: 4px;
+      border-radius: 2px;
+      background: var(--rp-error);
+      flex: none;
+    }
+    .fp-main {
+      flex: 1;
+      min-width: 0;
+    }
