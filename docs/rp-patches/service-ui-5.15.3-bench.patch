+describe('BulkBench', () => {
+  beforeEach(() => {
+    window.fetch = jest.fn(() => new Promise(() => {}));
+  });
+
+  it('one-cluster selection renders the three offer cards from a banded reply', () => {
+    const suggested = [
+      suggestRow({
+        issueType: 'pb001',
+        score: 90,
+        modelInfo: 'gbm;ng=1;band=auto;src=human-confirmed',
+        comment: 'known payment race',
