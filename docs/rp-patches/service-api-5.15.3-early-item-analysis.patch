+/**
+ * {@link IndexLaunch} extended with the total number of executed test items in
+ * the launch (analyzer-ng addition). The base class lives in the commons
+ * dependency jar and cannot be modified here; the analyzer messages are
+ * serialized by Jackson from the runtime type, so a subclass field reaches the
+ * wire naturally. The field is serialized only when set, so legacy analyzers
+ * receive the stock payload shape and ignore the extra key when present.
+ *
+ * <p>Semantics of {@code launchItemsCount}: the launch's executions total (the
+ * number the launch view shows as the executions count), taken from the launch
+ * statistics at the moment the analyze request is built. It is filled only on
+ * the launch-finish {@code analyze} route, where the statistics are final. On
+ * the early per-item {@code analyze_item_early} route the launch is still
+ * running, so the count is intentionally left absent and the analyzer treats
+ * the total as unknown.
+ */
+public class IndexLaunchNg extends IndexLaunch {
+
+  @JsonInclude(JsonInclude.Include.NON_NULL)
+  @JsonProperty("launchItemsCount")
+  private Long launchItemsCount;
+
+  public Long getLaunchItemsCount() {
+    return launchItemsCount;
+  }
+
+  public void setLaunchItemsCount(Long launchItemsCount) {
+    this.launchItemsCount = launchItemsCount;
+  }
+}
