+  /**
+   * Resolves the total number of executed test items in the launch from its
+   * statistics (the "statistics$executions$total" counter, the same number the
+   * launch view shows as the executions total). The statistics collection is
+   * eagerly fetched on the Launch entity, so this is safe on detached
+   * instances and requires no repository call.
+   *
+   * @param launch Analyzed launch
+   * @return executions total when present and positive, empty otherwise
+   */
+  private Optional<Long> resolveLaunchItemsCount(Launch launch) {
+    return ofNullable(launch.getStatistics())
+        .map(statistics -> StatisticsHelper.extractStatisticsCount(
+            "statistics$executions$total", statistics))
+        .filter(total -> total > 0)
+        .map(Integer::longValue);
+  }
