+.suggestion-meta {
+  margin: 0 20px 12px 20px;
+  padding-bottom: 12px;
+  border-bottom: 1px solid $COLOR--darkmode-gray-200;
+}
+
+.meta-caption {
+  color: $COLOR--darkmode-gray-100;
+  font-size: 9px;
+  font-weight: 700;
+  line-height: 14px;
+  letter-spacing: 0.4px;
+  text-transform: uppercase;
+}
+
+.suggested-defect-row {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.suggested-defect-pill {
+  cursor: default;
+}
+
+.provenance-chip {
+  display: inline-flex;
+  align-items: center;
+  height: 18px;
+  padding: 0 8px;
+  border-radius: 9px;
+  background-color: $COLOR--darkmode-gray-400;
+  color: $COLOR--darkmode-gray-100;
+  font-size: 10px;
+  font-weight: 500;
+  line-height: 18px;
+  white-space: nowrap;
+
+  &-rubric {
+    background-color: $COLOR--darkmode-topaz-additional;
+    color: $COLOR--darkmode-topaz-text;
+  }
+}
+
+.rubric-why {
