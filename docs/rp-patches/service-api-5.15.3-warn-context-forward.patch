 public class AnalyzerUtils {
 
+  /**
+   * How many WARN-level "near-error context" lines preceding the first ERROR are forwarded to the
+   * analyzer per test item. Mirrors the analyzer's own {@code CONTEXT_LOOKBACK_LINES} window
+   * (analyzer-ng {@code preprocessing/pipeline.py}) so the payload is bounded to exactly what the
+   * analyzer can consume — it keeps the identical exception+stack from collapsing two distinct
+   * failures (e.g. a "SLOW QUERY ..." app regression vs a "connection pool exhausted ..." infra
+   * outage) that would otherwise share one {@code error_hash} (ADV-1 / S16).
+   */
+  public static final int CONTEXT_LOOKBACK_LINES = 5;
+
   private AnalyzerUtils() {
     //static only
   }
 
+  /**
+   * Selects the logs forwarded to the analyzer for one test item: every ERROR+ log (the failure
+   * identity, unchanged from the legacy ERROR-only behaviour) PLUS the last
+   * {@link #CONTEXT_LOOKBACK_LINES} WARN-level lines that chronologically PRECEDE the first ERROR
+   * (the near-error discriminant, previously dropped).
+   *
+   * <p>The result is a {@link LinkedHashSet} in strict chronological order (by {@code logTime},
+   * {@code logId} breaking ties). Ordering matters: {@link IndexTestItem#getLogs()} is declared as
+   * a {@link Set}, but Jackson serializes the concrete collection in iteration order, so an ordered
+   * {@code LinkedHashSet} yields a time-ordered JSON {@code logs} array. The analyzer folds the
+   * WARN lines that appear before the first ERROR into {@code msg_text} (out of the identity hash),
+   * so it depends on the WARN context arriving before the ERROR — a plain {@link HashSet} would
+   * scramble that and silently drop the discriminant.
+   *
+   * <p>When the item has no ERROR log the result is empty, preserving the legacy contract that only
+   * items carrying an ERROR log are indexed (callers filter empty-log items out).
+   *
+   * @param logs     all WARN+ logs of the item (as returned by the WARN-level repository fetch)
+   * @param lookback max number of near-error WARN lines to keep (see {@link #CONTEXT_LOOKBACK_LINES})
+   * @return chronologically ordered ERROR+ logs plus the bounded near-error WARN context
+   */
+  public static Set<IndexLog> withNearErrorWarnContext(Collection<IndexLog> logs, int lookback) {
+    if (logs == null || logs.isEmpty()) {
+      return new LinkedHashSet<>();
+    }
+    final List<IndexLog> ordered = new ArrayList<>(logs);
+    ordered.sort(
+        Comparator.comparing(IndexLog::getLogTime,
+                Comparator.nullsLast(Comparator.naturalOrder()))
+            .thenComparing(IndexLog::getLogId,
+                Comparator.nullsLast(Comparator.naturalOrder())));
+
+    int firstError = -1;
+    for (int i = 0; i < ordered.size(); i++) {
+      if (ordered.get(i).getLogLevel() >= LogLevel.ERROR_INT) {
+        firstError = i;
+        break;
+      }
+    }
+    // No ERROR log -> nothing to analyze; item is not indexed (legacy behaviour).
+    if (firstError < 0) {
+      return new LinkedHashSet<>();
+    }
+
+    final Set<Integer> keep = new HashSet<>();
+    // Keep every ERROR+ log (the failure identity), wherever it sits.
+    for (int i = 0; i < ordered.size(); i++) {
+      if (ordered.get(i).getLogLevel() >= LogLevel.ERROR_INT) {
+        keep.add(i);
+      }
+    }
+    // Keep the last `lookback` WARN lines that precede the first ERROR (the context).
+    int taken = 0;
+    for (int i = firstError - 1; i >= 0 && taken < lookback; i--) {
+      final int level = ordered.get(i).getLogLevel();
+      if (level >= LogLevel.WARN_INT && level < LogLevel.ERROR_INT) {
+        keep.add(i);
+        taken++;
+      }
+    }
+
+    final LinkedHashSet<IndexLog> result = new LinkedHashSet<>();
+    for (int i = 0; i < ordered.size(); i++) {
+      if (keep.contains(i)) {
+        result.add(ordered.get(i));
+      }
+    }
+    return result;
+  }
+
