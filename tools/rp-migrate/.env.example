# Source ReportPortal instance (read-only)
SRC_URL=https://rp.example.com
SRC_PROJECT=my-project-key
SRC_USER=reader                # informational; auth is via the API key
SRC_API_KEY=xxxxxxxx-source-api-key

# Target ReportPortal instance (the one with analyzer-ng)
DST_URL=http://minikube.local
DST_PROJECT=migrated-project
DST_USER=superadmin
DST_API_KEY=xxxxxxxx-target-api-key

# Seconds to wait after finishing launches before replaying defect types.
# The analyzer drops defect_update events for items it has not indexed yet;
# the script also retries once if verification shows a shortfall.
INDEX_WAIT_S=20

# Optional: command template for analyzer-side verification that the ML loop
# actually consumed the replayed labels ({sql} is substituted). For the local
# minikube stand:
# ANALYZER_PG_EXEC=kubectl exec deploy/analyzer-pg -- psql -U analyzer -d analyzer -tA -c {sql}
ANALYZER_PG_EXEC=
