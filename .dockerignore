# Keep the build context small and deterministic. The image builds from
# pyproject.toml + uv.lock + src/ + VERSION only; everything else is noise.
.git
.github
.claude
.superpowers
.notes
tests
models
docker
docker-compose*.yml
Makefile
LICENSE
*.md
!README.md

# Node tooling: the inspector frontend's deps stay on the host. Its `dist/` is
# NOT ignored — the overlay image copies that host-built folder.
inspector/frontend/node_modules

# Python / tooling cruft. Patterns here are matched against the whole path from
# the context root, not per directory the way .gitignore works, so the `**/`
# prefix is what keeps nested caches (inspector/backend/__pycache__) out.
**/__pycache__/
**/*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# OS cruft
.DS_Store
